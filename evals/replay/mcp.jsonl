# 回放：MCP 断线后重建、重放握手、重试一次。
{"id":"mcp-disconnect-reconnects-without-replaying","description":"MCP 断线后重建连接，原调用结果未知，不自动重放","schemaVersion":1,"prereq":"python3","files":{"mcp.json":"{\"servers\": [{\"name\": \"flaky\", \"command\": \"python3\", \"args\": [\"{{home}}/flaky_mcp_server.py\", \"{{home}}/flaky.marker\"]}]}","flaky_mcp_server.py":"import json, os, sys\n\nmarker = sys.argv[1]\nfirst_run = not os.path.exists(marker)\n\ndef send(msg):\n    sys.stdout.write(json.dumps(msg) + '\\n')\n    sys.stdout.flush()\n\nfor line in sys.stdin:\n    line = line.strip()\n    if not line:\n        continue\n    msg = json.loads(line)\n    if 'id' not in msg:\n        continue\n    method = msg.get('method')\n    if method == 'initialize':\n        result = {'protocolVersion': '2025-06-18', 'capabilities': {'tools': {}},\n                  'serverInfo': {'name': 'flaky', 'version': '1'}}\n    elif method == 'tools/list':\n        result = {'tools': [{'name': 'echo', 'description': 'echo back',\n                             'inputSchema': {'type': 'object',\n                                             'properties': {'message': {'type': 'string'}}}}]}\n    elif method == 'tools/call':\n        if first_run:\n            # 第一次调用直接断开：写 marker 再退出，让客户端看到 EOF。\n            with open(marker, 'w') as f:\n                f.write('died\\n')\n            sys.exit(1)\n        text = msg['params']['arguments'].get('message', '')\n        result = {'content': [{'type': 'text', 'text': 'echo: ' + text}]}\n    else:\n        send({'jsonrpc': '2.0', 'id': msg['id'], 'error': {'code': -32601, 'message': 'no such method'}})\n        continue\n    send({'jsonrpc': '2.0', 'id': msg['id'], 'result': result})\n"},"recorded":{"turns":[{"say":"用 flaky 服务器的 echo 工具回一句 hi","gate":{"retrieve":false,"query":"","reason":"tool"},"replies":[{"tool_use":{"name":"flaky_echo","args":{"message":"hi"}}},{"text":"调用结果未知，需要核对远端状态后再决定是否重试。"}]}]},"expect":{"tools_used":["flaky_echo"],"tool_output_contains":["outcome unknown","not replayed"],"reply_contains":["outcome is unknown"],"events":["turnStarted","toolStarted:flaky_echo","toolCompleted:flaky_echo:error","turnCompleted"]}}
