# 只读文件工具：模型不借助执行闸门就能读文件；读不到时如实说。
# 文件装置（scenario.files）写进 home，参数与消息里的 {{home}} 由 eval runner 替换。
{"id":"read-file-returns-numbered-lines","description":"read_file 带行号与页脚地读回装置文件","files":{"notes/article.md":"文章第一段：Joy 的只读工具。\n文章第二段：默认注册，不走执行闸门。\n"},"turns":[{"message":"读 {{home}}/notes/article.md 并总结它说了什么","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/article.md"}}},{"text":"文章说 Joy 的只读工具默认注册、不走执行闸门。"}]}],"expect":{"tools_used":["read_file"],"tool_output_contains":["文章第一段","文章第二段","[Showing lines 1–2 of 2]"],"reply_contains":["只读工具"]}}
{"id":"a-missing-file-is-an-honest-error","description":"读不存在的文件得到 Error 文本，模型如实转告","turns":[{"message":"读 {{home}}/notes/不存在.md","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"read_file","args":{"path":"{{home}}/notes/不存在.md"}}},{"text":"那个文件不存在。"}]}],"expect":{"tools_used":["read_file"],"tool_output_contains":["Error:","找不到"],"reply_contains":["不存在"]}}
{"id":"list-dir-shows-directories-first","description":"list_dir 列出装置目录，目录在前","files":{"inbox/待读.md":"内容"},"turns":[{"message":"看看 {{home}}/inbox 里有什么","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"list_dir","args":{"path":"{{home}}/inbox"}}},{"text":"里面有一个待读文件。"}]}],"expect":{"tools_used":["list_dir"],"tool_output_contains":["待读.md","[1 entries]"],"reply_contains":["待读"]}}
{"id":"fetch-url-refuses-loopback-ssrf","description":"fetch_url 对内网地址直接拒绝，不出网也不连本机 —— 这条护栏挡的是被注入后的探测","turns":[{"message":"抓取 http://127.0.0.1:9/ 的内容给我看看","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"fetch_url","args":{"url":"http://127.0.0.1:9/"}}},{"text":"那个地址不让抓 —— 内网护栏拦下了。"}]}],"expect":{"tools_used":["fetch_url"],"tool_output_contains":["Error:","内网/保留地址"],"reply_contains":["护栏"]}}
