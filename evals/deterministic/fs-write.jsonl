# 文件写入工具（write_file / edit）：JOY_WRITE=1 才注册；闸门 = 本轮选的工作目录（cwd）
# + JOY_EXEC_WRITABLE_ROOTS，没选目录一处也写不了；on-request 每次写入问一次。
# 这里只测确定性路径（关闭、成功、拒因、范围外拒绝）；审批交互由 fs_write_tests 覆盖。
{"id":"write-file-creates-and-reports","description":"write_file 新建文件并报告行数与字节","settings":{"write_enabled":true},"turns":[{"message":"把这两行记到 {{home}}/notes/created.md","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"write_file","args":{"path":"{{home}}/notes/created.md","content":"第一行\n第二行\n"}}},{"text":"已写入 notes/created.md。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["write_file"],"tool_output_contains":["Wrote","(new, 2 lines)"],"reply_contains":["notes/created.md"]}}
{"id":"write-file-unchanged-skips-the-disk","description":"内容与磁盘一致时如实说没有写盘","settings":{"write_enabled":true},"files":{"same.md":"同一段内容\n"},"turns":[{"message":"把这段内容存到 {{home}}/same.md","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"write_file","args":{"path":"{{home}}/same.md","content":"同一段内容\n"}}},{"text":"内容没变。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["write_file"],"tool_output_contains":["content is unchanged, nothing was written"]}}
{"id":"edit-replaces-the-single-match","description":"edit 精确替换唯一匹配并给出 hunk","settings":{"write_enabled":true},"files":{"article.md":"alpha beta gamma\nsecond line\n"},"turns":[{"message":"把 {{home}}/article.md 里的 beta 改成 delta","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"edit","args":{"path":"{{home}}/article.md","old_string":"beta","new_string":"delta"}}},{"text":"已替换。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["edit"],"tool_output_contains":["Edited","- alpha beta gamma","+ alpha delta gamma"]}}
{"id":"edit-refuses-zero-matches","description":"old_string 不存在时拒绝并指向 read_file","settings":{"write_enabled":true},"files":{"article.md":"alpha beta gamma\n"},"turns":[{"message":"把 {{home}}/article.md 里的 zeta 改成 x","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"edit","args":{"path":"{{home}}/article.md","old_string":"zeta","new_string":"x"}}},{"text":"改不了，没找到 zeta。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["edit"],"tool_output_contains":["Error:","was not found","read_file"]}}
{"id":"edit-refuses-ambiguous-matches","description":"old_string 出现多次时拒绝且不动文件","settings":{"write_enabled":true},"files":{"twice.md":"beta here\nbeta there\n"},"turns":[{"message":"把 {{home}}/twice.md 里的 beta 改成 x","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"edit","args":{"path":"{{home}}/twice.md","old_string":"beta","new_string":"x"}}},{"text":"得先让它唯一。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["edit"],"tool_output_contains":["Error:","2 times"]}}
{"id":"write-file-refuses-outside-the-roots","description":"可写范围之外的路径被硬拒，审批也救不了","settings":{"write_enabled":true},"turns":[{"message":"把这条写到 /etc/joy-write-eval-denied.txt","gate":{"retrieve":false,"query":"","reason":"note"},"responses":[{"tool_use":{"name":"write_file","args":{"path":"/etc/joy-write-eval-denied.txt","content":"hi\n"}}},{"text":"范围外写不了。"}],"cwd":"{{home}}"}],"expect":{"tools_used":["write_file"],"tool_output_contains":["Error:","outside the writable scope"]}}
