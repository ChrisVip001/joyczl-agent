{"id":"long-tools-ok-count","description":"验收只认成功调用次数：两次真的写成功才算完成","settings":{"write_enabled":true},"cwd":"{{home}}/work","files":{"work/.keep":""},"task":{"title":"分批落两份文件","acceptance":[{"kind":"toolsOk","tool":"write_file","min":2}],"max_rounds":4},"message":"开始吧","gate":{"retrieve":false,"query":"","reason":"task"},"responses":[{"tool_use":{"name":"write_file","args":{"path":"{{home}}/work/a.md","content":"第一批\n"}}},{"text":"第一批好了。"},{"gate":{"retrieve":false,"query":"","reason":"task"}},{"tool_use":{"name":"write_file","args":{"path":"{{home}}/work/b.md","content":"第二批\n"}}},{"text":"两批都好了。"}],"expect":{"task_status":"done","task_checks_passed":true,"task_artifacts":2,"reply_contains":["两批都好了"]}}

