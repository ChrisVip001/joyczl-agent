{"id":"long-nested-folder-two-artifacts","description":"写到子目录里：目录不存在就建，两个交付物都按路径核对","settings":{"write_enabled":true},"cwd":"{{home}}/work","files":{"work/.keep":""},"task":{"title":"在输出目录里放两份","acceptance":[{"kind":"fileExists","path":"out/plan.md"},{"kind":"fileExists","path":"out/summary.md"}],"max_rounds":4},"message":"开始吧","gate":{"retrieve":false,"query":"","reason":"task"},"responses":[{"tool_use":{"name":"write_file","args":{"path":"{{home}}/work/out/plan.md","content":"# 计划\n1. 做\n"}}},{"text":"计划放好了。"},{"gate":{"retrieve":false,"query":"","reason":"task"}},{"tool_use":{"name":"write_file","args":{"path":"{{home}}/work/out/summary.md","content":"# 小结\n做完了\n"}}},{"text":"小结也放好了。"}],"expect":{"task_status":"done","task_checks_passed":true,"task_artifacts":2,"reply_contains":["小结也放好了"]}}

