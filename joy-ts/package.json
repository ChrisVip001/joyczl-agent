{
  "name": "joy-ts",
  "private": true,
  "type": "module",
  "description": "Joy's TypeScript side: the web cockpit and the chat gateway. The logic and the state live in Rust; this only carries the protocol to a browser and a chat platform.",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-timeout=30000",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "gateway:telegram": "node packages/gateway/src/bin-telegram.ts",
    "gateway:discord": "node packages/gateway/src/bin-discord.ts",
    "gateway:wechat": "node packages/gateway/src/bin-wechat.ts",
    "gateway:lark": "node packages/gateway/src/bin-lark.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  }
}
