{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // This package **emits no JS**: bundling is esbuild's job (see build in package.json).
    // So this is pure type checking, and the base config needs no changes — noEmit and
    // allowImportingTsExtensions fit together, letting the protocol shim import the artifacts' .ts.
    //
    // Why not run tsc to produce JS: the artifacts live outside the package directory, and tsc's
    // rootDir forbids .ts files outside the program (TS6059) — that would force us to copy the
    // artifacts in, and a copy starts drifting again, exactly what this architecture eliminates.
    "module": "esnext",
    "moduleResolution": "bundler",

    // Browsers have no process / Buffer. Without "types", @types/node gets pulled in
    // automatically, so those things pass type checking in page code — and blow up at runtime.
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"]
}
