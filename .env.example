# Joy 的环境变量模板。
#
# **Joy 不读这个文件。** 配置的唯一来源是进程的环境变量，`joyczl-config` 在
# 启动时读一次、之后不可变。想用它的话，由你自己 source：
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a
#   joy
#
# 运行中改配置走 config/write（落 <home>/settings.json，重启后仍生效），
# 或者直接 export。全部变量的权威说明见 docs/configuration.zh.md。
#
# 下面每一项都**默认注释掉**：复制过去不改也能跑，改了才生效的才是你想要的。

# ---- 模型 ---------------------------------------------------------------
# 选一个 provider（见 docs/configuration.zh.md 的完整列表与默认模型）：
# anthropic / openai / deepseek / gemini / kimi / glm / minimax / xai /
# openrouter / opencode_zen / opencode_go / ollama
#JOY_PROVIDER=anthropic

# 显式指定 key，优先于 provider 自己的变量（下表）。绝不写进仓库。
#JOY_API_KEY=

# 覆盖端点。本地推理（LM Studio / vLLM）就是靠它指过去的。
#JOY_BASE_URL=

# 主模型 / 便宜模型（后者给检索门与 consolidation 用）。
#JOY_MODEL=
#JOY_SMALL_MODEL=

# 单次模型调用的超时（秒）。
#JOY_LLM_TIMEOUT=120

# 各 provider 的 key 变量（不设 JOY_API_KEY 时按 JOY_PROVIDER 取对应那个）：
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#GEMINI_API_KEY=
#MOONSHOT_API_KEY=      # kimi
#ZHIPU_API_KEY=         # glm
#MINIMAX_API_KEY=
#XAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENCODE_ZEN_API_KEY=
#OPENCODE_GO_API_KEY=
# ollama 不需要 key（本地推理，见 docs/configuration.zh.md）

# ---- 状态目录 -----------------------------------------------------------
# state.db、SOUL.md、skills/、outbox/、traces/、settings.json 都在里面。
#JOY_HOME=./.joy

# ---- Loop 与记忆 --------------------------------------------------------
#JOY_MAX_ITERATIONS=10
# 推理模型（kimi-k3、gpt-5.x、gemini-*-pro）会先花输出 token 思考，
# 留够余量，别卡在 max_tokens。
#JOY_MAX_TOKENS=8192
# 工作记忆滑窗：更老的轮次折进滚动摘要（不是丢掉）。
#JOY_HISTORY_TURNS=12
# 每 N 轮提炼一次事实。
#JOY_CONSOLIDATE_EVERY=6
#JOY_RETRIEVAL_TOP_K=4

# ---- 混合检索（可选）----------------------------------------------------
# 开了才把向量相似度融进检索；需要下面这个模型，且旧事实要用
# `joy memory reindex` 补向量。
#JOY_EMBEDDINGS=0
#JOY_EMBED_MODEL=nomic-embed-text

# ---- 开关 ---------------------------------------------------------------
#JOY_APPLE_CALENDAR=0
#JOY_GOOGLE_CALENDAR=0
#JOY_EXPERIMENTAL=0
# triage 前门（图工作流）：失败开放，任何一步出问题都掉回普通 loop。
#JOY_GRAPH_WORKFLOWS=0

# ---- 执行命令（默认关，见 SECURITY.zh.md）--------------------------------
# 开了才会把 run_command 注册进工具表；放行表是空的时候什么都不许跑。
#JOY_EXEC=0
#JOY_EXEC_ALLOW=cargo test,git status,ls *
#JOY_EXEC_TIMEOUT=30

# ---- 工具与技能 ---------------------------------------------------------
# gather 的 github 扫描查哪个仓库。
#JOY_GH_REPO=owner/repo
# search_web：设了走 Tavily，没设退回 DuckDuckGo 的 HTML 端点。
#TAVILY_API_KEY=
# 额外的技能目录（冒号分隔），用来共享社区技能包。
#JOY_SKILL_DIRS=

# ---- 驾驶舱与网关 -------------------------------------------------------
#JOY_PORT=7777
#JOY_DASHBOARD_DIR=joy-ts/packages/dashboard/dist
# TS 客户端起哪个 joy 二进制（默认去 target/debug 找）。
#JOY_BIN=

# Telegram / Discord / 微信 / 飞书的变量各有各的规矩，
# 见 docs/gateways.zh.md（白名单、token、AES key 都在那儿）。
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOW=
#DISCORD_BOT_TOKEN=
#DISCORD_ALLOW=
#WECHAT_AES_KEY=
#LARK_APP_ID=
#LARK_APP_SECRET=
#LARK_ALLOW=

# ---- 评测 ---------------------------------------------------------------
# judge 类 eval 用哪个模型（默认跟主模型）。
#JOY_JUDGE_MODEL=
