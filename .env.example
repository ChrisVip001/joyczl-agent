# Joy's environment variable template.
#
# **Joy does not read this file.** The only config source is the process environment;
# `joyczl-config` reads it once at startup, immutable after. To use this, source it yourself:
#
#   cp .env.example .env
#   $EDITOR .env
#   set -a; source .env; set +a
#   joy
#
# To change config while running, use config/write (lands in <home>/settings.json, survives
# restarts), or just export. The authoritative reference for every variable is docs/configuration.zh.md.
#
# Numeric knobs have bounds; **invalid values error out and exit at startup** (never silently
# default), and the error names the variable. Bounds table: docs/configuration.zh.md "Invalid values".
#
# Every item below is **commented out by default**: uncommented and changed is what you want.

# ---- Models ---------------------------------------------------------------
# Pick a provider (full list and default models in docs/configuration.zh.md):
# anthropic / openai / deepseek / gemini / kimi / glm / minimax / xai /
# openrouter / opencode_zen / opencode_go / ollama
#JOY_PROVIDER=anthropic

# Set the key explicitly; takes precedence over the provider's own variable (below). Never commit it.

# Override the endpoint. This is how local inference (LM Studio / vLLM) gets pointed at.

# Main model / cheap model (the latter for the retrieval gate and consolidation).

# Timeout for a single model call (seconds).
#JOY_LLM_TIMEOUT=120
# Retries on rate limits / transient failures (0 = off; every retry notifies you).
#JOY_LLM_RETRIES=2
# How many rounds a goal may auto-continue (/goal goals; past that, report honestly unfinished).
#JOY_GOAL_MAX_ROUNDS=5

# Models and keys are **not configured here**: /model add <name> <vendor> [--env VAR] [--key ...],
# or the dashboard's "Models" panel. The variables below are just read targets for Joy itself:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
#DEEPSEEK_API_KEY=
#GEMINI_API_KEY=
#MOONSHOT_API_KEY=      # kimi
#ZHIPU_API_KEY=         # glm
#MINIMAX_API_KEY=
#XAI_API_KEY=
#OPENROUTER_API_KEY=
#OPENCODE_ZEN_API_KEY=
#OPENCODE_GO_API_KEY=
# ollama needs no key (local inference, see docs/configuration.zh.md)

# ---- State directory -----------------------------------------------------------
# state.db, SOUL.md, skills/, outbox/, traces/, settings.json all live in there.
#JOY_HOME=./.joy

# ---- Loop and memory --------------------------------------------------------
# Per-turn step budget. The last step is a wrap-up with the tools taken away, so hitting it
# produces "what I did / where I am stuck", not an apology.
#JOY_MAX_ITERATIONS=32
# Self-continuation: how many times one turn may keep itself alive. Two sources share the budget:
# the Stop hook demanding one more pass, and the built-in gate seeing open `pending`/`in_progress`
# todos **when the step cap cut the turn off**. 0 = off (a turn ends where it ends).
#JOY_AUTO_CONTINUE_MAX=2
# Steps bought by one continuation. A slice rather than a higher JOY_MAX_ITERATIONS: a bigger cap
# also makes a runaway turn more expensive.
#JOY_TURN_STEP_SLICE=12
# Reasoning models (kimi-k3, gpt-5.x, gemini-*-pro) spend output tokens thinking first;
# leave headroom so they don't get stuck at max_tokens.
#JOY_MAX_TOKENS=8192
# Working-memory sliding window (cap): older turns fold into a rolling summary (not dropped).
#JOY_HISTORY_TURNS=12
# Estimated context window (overrides the provider table's approximation); local models vary wildly.
#JOY_CONTEXT_WINDOW=
# Start compacting at this fraction of the window (tokens are the real gate; rounds are a cap).
#JOY_COMPACT_THRESHOLD=0.8
# How old a crashed turn's checkpoint may be before startup stops resuming it on its own (minutes).
# A checkpoint is crash recovery, so the honest window is seconds to minutes; past an hour "today"
# has moved and the intent has cooled. The stale turn is marked abandoned with one stderr line.
#JOY_RESUME_MAX_AGE=60
# In-turn tool-result budget: past the total, swap the largest for stubs (full text to disk). 0 = off.
#JOY_TOOL_RESULT_TOTAL_CHARS=200000
#JOY_TOOL_RESULT_MAX_CHARS=30000
# Distill facts every N turns.
#JOY_CONSOLIDATE_EVERY=6
#JOY_RETRIEVAL_TOP_K=4
# How many of the NEWEST tool results are never stubbed (trimming runs oldest-first).
#JOY_TOOL_RESULT_KEEP_RECENT=3
# Per-TURN token cap (input + output). At 80% the tools are taken away and the model wraps up.
# 0 = off (default): the step cap already bounds rounds.
#JOY_TURN_TOKEN_BUDGET=0

# ---- Prompt shape (what the model sees every turn) ---------------------------------
# auto = thin for hosted models, full for ollama / lmstudio; a SOUL.md you edited wins either way.
#JOY_SOUL_MODE=auto
# The skill catalog always rides along (name + one line); bodies load on demand.
#JOY_SKILL_INDEX_TOKENS=200
#JOY_SKILL_BODY_TOKENS=1200
# eager = every tool schema in the request; deferred = always-on only, `find_tools` opens the rest.
#JOY_TOOL_POLICY=eager
# Percentage of the window at which the context meter shows a notice.
#JOY_CONTEXT_WARN_RATIO=85

# ---- Hybrid retrieval (optional)----------------------------------------------------
# Only when on are vector similarities blended into retrieval; needs the model below, and old
# facts need `joy memory reindex` to backfill vectors.
#JOY_EMBEDDINGS=0
#JOY_EMBED_MODEL=nomic-embed-text

# ---- Switches ---------------------------------------------------------------
#JOY_APPLE_CALENDAR=0
#JOY_GOOGLE_CALENDAR=0
#JOY_EXPERIMENTAL=0
# triage front door (graph workflows): fails open; any failure drops back to the plain loop.
#JOY_GRAPH_WORKFLOWS=0

# ---- Command execution (default off, see SECURITY.zh.md)--------------------------------
# run_command joins the tool table only when on; with an empty allowlist nothing may run.
# Lifecycle hooks (12 events, shell handlers). Default off.
#JOY_HOOKS=0
# Model routing force mode (auto|fixed). Default reads <home>/model-routes.json (default fixed).
#JOY_MODEL_ROUTE=
#JOY_HOOKS_TIMEOUT=

# ---- Notifications (M3a)----------------------------------------------------------
# Only when on is <home>/notify.json read ({"slack": "https://hooks.slack.com/services/…"}) and
# notifications pushed to the webhooks there: approval requests, background job completion, goal
# endings. Default off — sending data to external services is a decision made by the user's hand.
#JOY_NOTIFY=130
#JOY_EXEC=0
# Subagents (delegate_task): default off.
#JOY_DELEGATE=0
#JOY_EXEC_ALLOW=cargo test,git status,ls *
#JOY_EXEC_TIMEOUT=30
# The sandbox has no network by default (turn it on only for commands that need downloads).
# Whether to ask when nothing matches the allowlist (never / on-request). No answer = deny.
#JOY_APPROVAL=never
#JOY_APPROVAL_TIMEOUT=120
#JOY_EXEC_NETWORK=0
# Extra writable directories (colon-separated, must be existing absolute paths); build caches.
#JOY_EXEC_WRITABLE_ROOTS=/Users/you/project/target
# Directories whose writes need no confirmation in on-request mode (what "记住这条" writes for
# write_file/edit). A "don't ask again" list, NOT a writable root — outside the boundary nothing lands.
#JOY_WRITE_ALLOW_DIRS=/Users/you/project

# ---- Tools and skills ---------------------------------------------------------
# Which repo gather's github scan queries.
#JOY_GH_REPO=owner/repo
# search_web: with this set, Tavily; without, keyless Bing HTML then DuckDuckGo.
#TAVILY_API_KEY=
# Second keyed backend in the chain (tried after Tavily).
#BRAVE_API_KEY=
# Cap the searches per turn (default 20) — a turn that searches forever is a loop.
#JOY_SEARCH_MAX_PER_TURN=20
# Set 0 to disable the keyless Bing backend (works on networks that block DDG).
#JOY_SEARCH_BING=1
# Set 0 to disable the keyless DuckDuckGo backend (the last fallback).
# With both off and no key at all, search_web is not registered at all.
#JOY_SEARCH_DDG=1
# Extra skill directories (colon-separated), for sharing community skill packs.
# Their skills are "built-in" in the dashboard's capability center: greyed out,
# read-only — the user's own <home>/skills always wins on a same name.
#JOY_SKILL_DIRS=
# Extra mcp.json files (colon-separated), for machine-wide MCP servers. Same
# story: built-in in the capability center, read-only; <home>/mcp.json wins.
#JOY_MCP_CONFIG=

# ---- Dashboard and gateways -------------------------------------------------------
#JOY_PORT=7777

# --- hub resource pool (three pooling policies)---
#JOY_HUB_MAX_OPEN=32
#JOY_HUB_IDLE_SECS=900
#JOY_DASHBOARD_DIR=joy-ts/packages/dashboard/dist
# Which joy binary the TS client starts (defaults to looking in target/debug).
#JOY_BIN=

# Telegram / Discord / WeChat / Lark each have their own rules for variables;
# see docs/gateways.zh.md (allowlist, token, AES key are all documented there).
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_ALLOW=
#DISCORD_BOT_TOKEN=
#DISCORD_ALLOW=
#WECHAT_AES_KEY=
#LARK_APP_ID=
#LARK_APP_SECRET=
#LARK_ALLOW=

# ---- Dashboard HTTP face ------------------------------------------------------
# Bind address: localhost only by default. To view from another machine you must also set a
# token — without one, startup refuses outright (a deployment decision, not a switch).
#JOY_OPS_HOST=127.0.0.1
# Bearer token for /api/*. Optional on loopback (no auth locally); if set, localhost sends it too.
#JOY_OPS_TOKEN=

# ---- Evals ---------------------------------------------------------------
# Which model judge-type evals use (defaults to the main model).
#JOY_JUDGE_MODEL=
